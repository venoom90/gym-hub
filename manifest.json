{
  "name": "Gym Analytics Hub",
  "short_name": "GymHub",
  "description": "Импорт и аналитика тренировок GymUp",
  "start_url": "/gym-hub/",
  "id": "/gym-hub/",
  "scope": "/gym-hub/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#111318",
  "theme_color": "#111318",
  "icons": [
    {
      "src": "https://fonts.gstatic.com/s/i/short-term/release/materialsymbolsoutlined/fitness_center/default/48px.svg",
      "sizes": "48x48 72x72 96x96 144x144 192x192 512x512",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "share_target": {
    "action": "/gym-hub/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "workout_file",
          "accept": ["text/plain", "text/*", ".txt", "application/octet-stream"]
        }
      ]
    }
  }
}